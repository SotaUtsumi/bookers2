<div class="container">
  <div class="row">
    <div class="mx-auto col-11 col-sm-10 col-lg-8 col-xl-6">
      <h1>welcome to <i class="fas fa-book"></i><strong>Bookers</strong>  !!</h1>
      <p>In <i class="fas fa-book"></i><strong>Bookers</strong>,</p>
      <p>you can share and exchange your opinions , inpressions , and emotions</p>
      <p>about various books!</p>
      
      <div class="btn-wrapper mt-4">
        <div class="row">
          <!-- new_user_session_path を new_session_path に修正 -->
          <!-- Bootstrap 5用に btn-block と併せて w-100 を追加してボタンを横幅いっぱいにします -->
          <%= link_to 'Log in', new_session_path, class: "btn btn-info btn-sm btn-block w-100 mb-3 sign_in" %>
        </div>
        <div class="row">
          <!-- new_user_registration_path を new_user_path に修正 -->
          <%= link_to 'Sign up', new_user_path, class: "btn btn-success btn-sm btn-block w-100 sign_up" %>
        </div>
      </div>
    </div>
  </div>
</div>